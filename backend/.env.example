# Copy this file to .env and fill in real values. Never commit .env itself.

ENV=development

# PostgreSQL in production (see docs/DEPLOYMENT.md), e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/ecotwin
# Defaults to a local SQLite file if unset — convenient for local dev/tests
# without a running Postgres server.
DATABASE_URL=sqlite:///./ecotwin.db

# Optional. If unset, the AI Reasoning Layer is disabled and every
# investigation uses the deterministic fallback engine instead
# (see docs/AI_ARCHITECTURE.md, docs/RELIABILITY_AND_TRUST.md).
ANTHROPIC_API_KEY=

EMISSION_FACTOR_REGION=IN

# Comma-separated list of allowed frontend origins for CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
